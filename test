import json
import os
import subprocess
import tempfile
import time
import socket
import requests
from concurrent.futures import ThreadPoolExecutor, as_completed
from urllib.parse import urlparse, parse_qs, unquote


XRAY_PATH = "xray.exe"

INPUT_FILE = "configs.txt"
RESULT_FILE = "results.txt"
WORKING_FILE = "working_configs.txt"

TEST_URL = "https://api.telegram.org"
TEST_TIMEOUT = 5

START_PORT = 20000

# Number of configs tested at the same time.
# 10-15 is a good starting point; increase if your PC/network can handle it.
MAX_WORKERS = 20


def find_free_port(start=START_PORT):
    port = start

    while True:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(("127.0.0.1", port))
                return port
            except OSError:
                port += 1


def vless_to_xray(vless_url, socks_port):
    parsed = urlparse(vless_url)

    if parsed.scheme.lower() != "vless":
        raise ValueError("Not a VLESS URL")

    uuid = parsed.username
    address = parsed.hostname
    port = parsed.port

    params = parse_qs(parsed.query)

    security = params.get("security", ["none"])[0]
    network = params.get("type", ["tcp"])[0]

    sni = params.get("sni", [address])[0]
    fingerprint = params.get("fp", ["chrome"])[0]

    host = params.get("host", [None])[0]

    path = params.get("path", ["/"])[0]
    path = unquote(path)

    stream_settings = {
        "network": network,
        "security": security
    }

    # TLS
    if security == "tls":
        stream_settings["tlsSettings"] = {
            "serverName": sni,
            "fingerprint": fingerprint,
            "allowInsecure": False
        }

        alpn = params.get("alpn", [])
        if alpn:
            stream_settings["tlsSettings"]["alpn"] = [
                unquote(x) for x in alpn[0].split(",")
            ]

    # WebSocket
    if network == "ws":
        ws_settings = {
            "path": path
        }

        if host:
            ws_settings["headers"] = {
                "Host": host
            }

        stream_settings["wsSettings"] = ws_settings

    config = {
        "log": {
            "loglevel": "warning"
        },

        "inbounds": [
            {
                "listen": "127.0.0.1",
                "port": socks_port,
                "protocol": "socks",
                "settings": {
                    "auth": "noauth",
                    "udp": True
                }
            }
        ],

        "outbounds": [
            {
                "protocol": "vless",
                "settings": {
                    "vnext": [
                        {
                            "address": address,
                            "port": port,
                            "users": [
                                {
                                    "id": uuid,
                                    "encryption": "none"
                                }
                            ]
                        }
                    ]
                },
                "streamSettings": stream_settings
            },

            {
                "protocol": "freedom",
                "tag": "direct"
            }
        ]
    }

    return config


def wait_for_port(port, timeout=2.5):
    deadline = time.perf_counter() + timeout

    while time.perf_counter() < deadline:
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.15):
                return True
        except OSError:
            time.sleep(0.03)

    return False


def test_config(vless_url, index):

    socks_port = find_free_port(START_PORT + index)

    temp_file = tempfile.NamedTemporaryFile(
        mode="w",
        suffix=".json",
        delete=False,
        encoding="utf-8"
    )

    config_path = temp_file.name

    try:

        config = vless_to_xray(vless_url, socks_port)

        json.dump(config, temp_file, separators=(",", ":"))

        temp_file.close()

        process = subprocess.Popen(
            [
                XRAY_PATH,
                "run",
                "-config",
                config_path
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

        # Wait until local SOCKS proxy is available
        if not wait_for_port(socks_port):
            process.kill()
            process.wait()

            return {
                "config": vless_url,
                "status": "FAILED",
                "time": None
            }

        proxy = (
            f"socks5h://127.0.0.1:{socks_port}"
        )

        proxies = {
            "http": proxy,
            "https": proxy
        }

        start = time.perf_counter()

        # Only measure the request itself. stream=True avoids downloading
        # an unnecessary response body.
        with requests.Session() as session:
            response = session.get(
                TEST_URL,
                proxies=proxies,
                timeout=TEST_TIMEOUT,
                stream=True
            )

        elapsed = (time.perf_counter() - start) * 1000

        try:
            response.close()
        except Exception:
            pass

        process.kill()
        process.wait()

        if response.status_code == 200:
            return {
                "config": vless_url,
                "status": "OK",
                "time": round(elapsed, 2)
            }

        return {
            "config": vless_url,
            "status": "FAILED",
            "time": None
        }

    except Exception as e:

        try:
            process.kill()
            process.wait()
        except:
            pass

        return {
            "config": vless_url,
            "status": "FAILED",
            "time": None
        }

    finally:

        try:
            os.remove(config_path)
        except:
            pass


def main():

    if not os.path.exists(INPUT_FILE):
        print(f"File not found: {INPUT_FILE}")
        return

    if not os.path.exists(XRAY_PATH):
        print(f"Xray not found: {XRAY_PATH}")
        return

    with open(
        INPUT_FILE,
        "r",
        encoding="utf-8"
    ) as f:

        configs = [
            line.strip()
            for line in f
            if line.strip()
            and line.strip().lower().startswith("vless://")
        ]

    print()
    print("=" * 60)
    print(f"Found {len(configs)} VLESS configurations")
    print("=" * 60)
    print()

    # Test many configurations simultaneously instead of one-by-one.
    # This is the main speed improvement: up to MAX_WORKERS Xray instances
    # can be tested concurrently.
    # The old version waited for each config to finish before starting the next one.
    results = [None] * len(configs)

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {
            executor.submit(test_config, config, i): i
            for i, config in enumerate(configs)
        }

        completed = 0

        for future in as_completed(futures):
            i = futures[future]

            try:
                result = future.result()
            except Exception:
                result = {
                    "config": configs[i],
                    "status": "FAILED",
                    "time": None
                }

            results[i] = result
            completed += 1

            if result["status"] == "OK":
                print(
                    f"[{completed}/{len(configs)}] "
                    f"#{i + 1} OK - {result['time']} ms",
                    flush=True
                )
            else:
                print(
                    f"[{completed}/{len(configs)}] "
                    f"#{i + 1} FAILED",
                    flush=True
                )

    # Remove any unexpected empty result.
    results = [r for r in results if r is not None]

    # Keep only successful configs
    working = [
        r for r in results
        if r["status"] == "OK"
    ]

    # Fastest first
    working.sort(
        key=lambda x: x["time"]
    )

    # ------------------------------------------------
    # Save results
    # ------------------------------------------------

    with open(
        RESULT_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        f.write(
            "VLESS CONFIGURATION TEST RESULTS\n"
        )

        f.write(
            "=" * 70 + "\n\n"
        )

        for i, result in enumerate(
            working,
            1
        ):

            f.write(
                f"{i}. {result['time']} ms\n"
            )

            f.write(
                result["config"]
            )

            f.write("\n\n")

    # ------------------------------------------------
    # Save working configs
    # ------------------------------------------------

    with open(
        WORKING_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        for result in working:

            f.write(
                result["config"]
            )

            f.write("\n")

    print()
    print("=" * 60)
    print("RESULT")
    print("=" * 60)

    print(
        f"Working: {len(working)} / {len(configs)}"
    )

    if working:

        print()
        print("Fastest configurations:")
        print()

        for i, result in enumerate(
            working[:10],
            1
        ):

            print(
                f"{i}. {result['time']} ms"
            )

    print()
    print(f"Saved: {RESULT_FILE}")
    print(f"Saved: {WORKING_FILE}")
    print()


if __name__ == "__main__":
    main()
